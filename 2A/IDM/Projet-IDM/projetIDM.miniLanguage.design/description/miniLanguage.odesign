          <ownedTools xsi:type="tool:EdgeCreationDescription" name="LinkCreation" label="Link Input to Output" edgeMappings="//@ownedViewpoints[name='miniLanguageViewpoint']/@ownedRepresentations[name='MiniLanguage']/@defaultLayer/@edgeMappings[name='OutputToInputEdge']">
            <sourceVariable name="source"/>
            <targetVariable name="target"/>
            <sourceViewVariable name="sourceView"/>
            <targetViewVariable name="targetView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:source">
