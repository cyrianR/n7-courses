            <variable name="container"/>
            <viewVariable name="containerView"/>
            <initialOperation>
              <firstModelOperations xsi:type="tool_1:ChangeContext" browseExpression="[container/]">
                <subModelOperations xsi:type="tool_1:CreateInstance" typeName="miniLanguage::Return" referenceName="miniLanguageElement">
                  <subModelOperations xsi:type="tool_1:SetValue" featureName="name" valueExpression="Return"/>
                  <subModelOperations xsi:type="tool_1:ChangeContext" browseExpression="aql:self.input.return">
                    <subModelOperations xsi:type="tool_1:CreateInstance" typeName="miniLanguage::Input" referenceName="input"/>
                  </subModelOperations>
                </subModelOperations>
              </firstModelOperations>
            </initialOperation>
          </ownedTools>
